<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Junction</RootNamespace>
    <AssemblyName>Junction</AssemblyName>
    <PackageId>Junction</PackageId>
    <Description>PostgreSQL-native messaging for .NET, one coherent API: a competing-consumer work queue (fan-in, exactly-once processing via FOR UPDATE SKIP LOCKED and fenced leases) and a Kafka-inspired durable event stream (fan-out, per-consumer durable cursors, replay). No broker required — runs on your existing connection.</Description>
    <Authors>Acorel</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Junction.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    High-throughput bulk append path (Npgsql binary COPY) for the Stream module, provided by
    BulkForge (clemkd/BulkForge). Referenced as a sibling repo checkout during co-development;
    publish BulkForge to a NuGet feed and switch these to <PackageReference> for a standalone/CI build.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\BulkForge\src\BulkForge\BulkForge.csproj" />
    <ProjectReference Include="..\..\..\BulkForge\src\BulkForge.PostgreSql\BulkForge.PostgreSql.csproj" />
  </ItemGroup>

</Project>
