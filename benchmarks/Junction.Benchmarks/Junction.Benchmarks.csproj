    <RootNamespace>Junction.Benchmarks</RootNamespace>
    <AssemblyName>Junction.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
